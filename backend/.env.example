# LLM設定例
LLM_PROVIDER=mock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=llama3.1:8b
# DB（既定SQLite。Postgres利用時）
# DB_PATH=backend/data/app.db
# DATABASE_URL=postgresql://app:app@localhost:5432/plans
# SSO（プロキシ経由。設定時のみ有効）
# SSO_TRUSTED_HEADER=X-Remote-User
# SSO_TRUSTED_NETWORKS=10.0.0.0/8,127.0.0.1/32
# SSO_DEFAULT_ROLE=teacher
# SSO_ADMINS=admin1
# CORS_ORIGINS=http://localhost:3000
# 簡易運用モード（委員会許可など組織承認がある場合。既定OFF）
# SIMPLE_MODE=1
